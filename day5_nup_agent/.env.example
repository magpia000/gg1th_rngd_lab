# DAY 3 설정 예시. 각 조의 실제 장치·서버 포트로 바꿔 .env로 저장한다.
# Linux 서버에서는 source .env, Windows Python에서는 python-dotenv가 읽는다.
MODEL_ID=furiosa-ai/Qwen3-8B-FP8
# MODEL_ID=Qwen/Qwen3-4B-FP8
# Windows PC에서 SSH -L 연결 후 접속하는 로컬 주소다.
# export OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
MODEL_BASE_URL=http://127.0.0.1:8000/v1
# 인증을 사용하지 않는 교육용 로컬 서버의 자리표시자다. 실제 비밀키가 아니다.
OPENAI_API_KEY=your_openai_api_key

# tavily 검색 api
TAVILY_API_KEY=your_tavily_api_key
